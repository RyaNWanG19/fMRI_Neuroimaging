# Only source trees, validation code, and run documentation belong in Git.
# Data, outputs, figures, project metadata, and other local root files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/code/
!/functional_clustering/
!/tests/

# Research data and generated artifacts, including inside source directories.
*.mat
*.nii
*.nii.gz
*.h5
*.hdf5
*.csv
*.tsv
*.fig
*.png
*.jpg
*.jpeg
*.gif
*.tif
*.tiff
*.pdf
*.pptx
*.zip
*.tar
*.tar.gz
*.log
*.err

# MATLAB temporary and local project files.
*.asv
*.autosave
*~
*.bak
*.mex*
*.slx.original
*.rwd
*.prj

# Python, Node, editor, and OS caches/dependencies.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
.chart-data-*/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
